# SPOP lightweight vocabulary (Draft)
# Namespace: https://w3id.org/spop/ns#
# Profile of RDF 1.2 — not a competing standard.
# License: Apache-2.0

VERSION "1.2"
PREFIX spop:  <https://w3id.org/spop/ns#>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:   <http://www.w3.org/2002/07/owl#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX vann:  <http://purl.org/vocab/vann/>

spop: a owl:Ontology ;
    dcterms:title "SPOP Vocabulary"@en ;
    dcterms:description "Lightweight terms for the SPOP (Subject–Predicate–Object–Provenance) profile of RDF 1.2."@en ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    owl:versionInfo "0.1.0-draft" ;
    vann:preferredNamespacePrefix "spop" ;
    vann:preferredNamespaceUri "https://w3id.org/spop/ns#" ;
    rdfs:comment "DRAFT vocabulary. Subject to change."@en .

#################################################################
# Provenance properties (minimum set)
#################################################################

spop:source a rdf:Property, owl:ObjectProperty ;
    rdfs:label "source"@en ;
    rdfs:comment "Document identity for the source from which the statement was derived. Aligns informatively with prov:wasDerivedFrom and dcterms:source."@en ;
    rdfs:isDefinedBy spop: ;
    rdfs:seeAlso prov:wasDerivedFrom, dcterms:source .

spop:documentVersion a rdf:Property, owl:DatatypeProperty ;
    rdfs:label "document version"@en ;
    rdfs:comment "Version string or identifier of the source document."@en ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy spop: .

spop:documentType a rdf:Property, owl:ObjectProperty ;
    rdfs:label "document type"@en ;
    rdfs:comment "Closed document-type classification: Organization Value, Process, or Informational."@en ;
    rdfs:range spop:DocumentType ;
    rdfs:isDefinedBy spop: .

spop:owner a rdf:Property, owl:ObjectProperty ;
    rdfs:label "owner"@en ;
    rdfs:comment "Agent or organization that owns the source document. Aligns informatively with dcterms:publisher and prov:wasAttributedTo."@en ;
    rdfs:isDefinedBy spop: ;
    rdfs:seeAlso dcterms:publisher, prov:wasAttributedTo .

spop:confidence a rdf:Property, owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "Published confidence in the statement, in the closed interval [0.0, 1.0]. When the publisher is not the authoritative owner, confidence SHOULD be internal_confidence × 0.9."@en ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy spop: .

spop:extractedAt a rdf:Property, owl:DatatypeProperty ;
    rdfs:label "extracted at"@en ;
    rdfs:comment "Timestamp when the statement was extracted or created in the publishing system. Aligns informatively with prov:generatedAtTime."@en ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy spop: ;
    rdfs:seeAlso prov:generatedAtTime, dcterms:created .

#################################################################
# Document types (working terms)
# org_value  → spop:OrgValue
# process    → spop:Process
# informational → spop:Informational
#################################################################

spop:DocumentType a rdfs:Class, owl:Class ;
    rdfs:label "Document Type"@en ;
    rdfs:comment "Abstract class for SPOP document-type values."@en ;
    rdfs:isDefinedBy spop: .

spop:OrgValue a spop:DocumentType, owl:NamedIndividual ;
    rdfs:label "Organization Value Document"@en ;
    rdfs:comment "Working code: org_value. Documents expressing mission, principles, values, policy intent, or ethical constraints. (Philosophical layer acknowledged in the profile: axiology.)"@en ;
    rdfs:isDefinedBy spop: .

spop:Process a spop:DocumentType, owl:NamedIndividual ;
    rdfs:label "Process Document"@en ;
    rdfs:comment "Working code: process. Documents defining procedures, workflows, operating instructions, or how-to governance. (Philosophical layer acknowledged in the profile: praxeology.)"@en ;
    rdfs:isDefinedBy spop: .

spop:Informational a spop:DocumentType, owl:NamedIndividual ;
    rdfs:label "Informational Document"@en ;
    rdfs:comment "Working code: informational. Documents carrying facts, observations, reports, reference knowledge, or situational data. (Philosophical layer acknowledged in the profile: epistemology.)"@en ;
    rdfs:isDefinedBy spop: .
